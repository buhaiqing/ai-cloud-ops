{
  "task": "M2 — Web Dashboard MVP",
  "strategy": "phased_workflow+gcl_batch+parallel_subagents",
  "phase_1_status": {
    "M2-7 REST API": "✅ done, 19 tests pass (router_test, rules_test, incidents_test, ws_test)",
    "M2-4 backend CRUD": "✅ done, included in api package",
    "M2-6 state machine": "✅ done, canTransition pure-function + 4 tests pass",
    "M2-8 WebSocket backend": "✅ done, RFC 6455 minimal + hub pub/sub + 9 tests pass",
    "M2-1 Next.js scaffold": "🚧 in progress (package.json/tsconfig/tailwind/layout/home/NavBar/api client done)",
    "M2-3 frontend alerts": "🚧 done (list page + detail page + actions wired to incident API)",
    "migrations": "✅ 0002_alert_rules.sql + 0003_incident_audit.sql added"
  },
  "phase_2_subagent_dispatch": {
    "concurrency": 3,
    "subagents": [
      {
        "id": "A",
        "label": "Resources + Stats frontend",
        "purpose": "M2-2 (resources list) + M2-9 (stats dashboard)",
        "deliverables": [
          "web/app/resources/page.tsx",
          "web/app/stats/page.tsx",
          "tests for both"
        ]
      },
      {
        "id": "B",
        "label": "Rules CRUD frontend",
        "purpose": "M2-4 (rules list/create/edit/delete UI)",
        "deliverables": [
          "web/app/rules/page.tsx",
          "web/app/rules/[id]/page.tsx",
          "web/components/RuleForm.tsx",
          "tests"
        ]
      },
      {
        "id": "C",
        "label": "Auth + WebSocket frontend",
        "purpose": "M2-5 (session/cookie/CSRF) + M2-8 (browser WS client)",
        "deliverables": [
          "internal/auth/session.go (Go session store + cookie)",
          "web/lib/auth.ts (frontend auth helpers)",
          "web/lib/ws.ts (browser WS reconnect/subscribe)",
          "web/app/login/page.tsx",
          "Go + frontend tests"
        ]
      }
    ]
  },
  "tdd_principles": [
    "Tests first, impl second",
    "Each file gets a test counterpart",
    "Run go test / npm test before claiming done"
  ],
  "constraints": {
    "concurrency_cap": 3,
    "skill_protocol": "TDD strict; GCL — Generator(subagent)+Critic(orchestrator)",
    "no_overlap_files": "Each subagent owns distinct paths; conflicts surfaced via review"
  }
}