      "id": "ecs-cpu-high-01",
      "category": "ECS",
      "difficulty": "easy",
      "alert_payload": {
        "alert_id": "alert-001",
        "alert_name": "ECS_CPU_High",
        "severity": "warning",
        "resource_id": "i-bp1xxxxxxxxxx",
        "region": "cn-hangzhou",
        "metric": {
          "namespace": "acs_ecs",
          "metric_name": "CPUUtilization",
          "value": 96.5,
          "threshold": 90.0,
          "duration_minutes": 15
        },
        "tags": {"env": "prod", "service": "api-gateway"}
      },
      "expected_root_cause_keywords": ["CPU", "持续", "高负载"],
      "expected_recommendation_type": "restart_or_scale",
      "scoring_notes": "简单场景，AI 应能直接定位 CPU 持续高位并给出重启/扩容建议"
    },
