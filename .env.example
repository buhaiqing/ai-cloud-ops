# ============================================================================
# AI-Native Alibaba Cloud Multi-Account Ops Console — Environment Template
# ============================================================================
# ⚠️  CRITICAL: This file is the .env.example — it MUST be committed.
#              Real secrets go in .env (which is .gitignored).
# ⚠️  After creating .env: chmod 0600 .env
# ============================================================================

# ----------------------------------------------------------------------------
# Alibaba Cloud credentials — for STS AssumeRole
# ----------------------------------------------------------------------------
# Initial AccessKey (used only to call STS AssumeRole; never for direct API access)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Per-account STS Role ARNs (JSON map: account_name -> RoleARN)
# Example:
#   ALIYUN_ACCOUNTS='{"prod":"acs:ram::123:role/ai-cloud-ops","staging":"acs:ram::456:role/ai-cloud-ops"}'
ALIYUN_ACCOUNTS=

# Per-account region list (JSON map: account_name -> [region_list])
# Example:
#   ALIYUN_REGIONS='{"prod":["cn-hangzhou","cn-beijing"],"staging":["cn-shanghai"]}'
ALIYUN_REGIONS=

# ----------------------------------------------------------------------------
# LLM provider credentials
# ----------------------------------------------------------------------------
# Anthropic (Claude) — recommended for AI Agent structured diagnostics
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: OpenAI, Qwen, DeepSeek — for multi-model A/B testing
# OPENAI_API_KEY=
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=

# ----------------------------------------------------------------------------
# PostgreSQL (Docker Compose uses these by default)
# ----------------------------------------------------------------------------
POSTGRES_USER=aiops
POSTGRES_PASSWORD=
POSTGRES_DB=aiops

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
WEBHOOK_PORT=8080
HEALTH_CHECK_PORT=8081

# ----------------------------------------------------------------------------
# Tuning
# ----------------------------------------------------------------------------
# STS Token cache TTL (seconds) — recommended 2700 (45 min, refresh 5 min before expiry)
STS_CACHE_TTL=2700
# Resource metadata cache TTL (seconds) — 5-15 min
RESOURCE_CACHE_TTL=600
# CloudMonitor webhook signature verification secret
WEBHOOK_SIGNING_SECRET=

# AI eval mode — when true, AI Agent logs structured eval samples to logs/eval/
AI_EVAL_MODE=true

# ----------------------------------------------------------------------------
# M3 — HITL execution rate limit (per account, per hour)
# ----------------------------------------------------------------------------
# Max number of approved plans that may enter `running` status per account per
# rolling hour. Exceeding it returns HTTP 429 and leaves the plan in `approved`.
# Default 10 (matches internal/api/exec.go defaultExecRateLimit).
EXEC_RATE_LIMIT=10

# ----------------------------------------------------------------------------
# M3-6 — automatic rollback for failed executions
# ----------------------------------------------------------------------------
# When "true", a failed execute rolls back already-completed actions in
# reverse order (requires Deps.RollbackAction wired) and the plan ends in
# `rolled_back` instead of `failed`. Default: disabled.
AICO_ROLLBACK_ENABLED=false